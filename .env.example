# Required for local LLM-powered features
GEMINI_API_KEY=your_gemini_api_key

# Model selection (override defaults)
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_INDEX_MODEL=gemini-2.0-flash
# GEMINI_LIVE_MODEL=gemini-2.0-flash-lite

# Target domain (leave empty for generic browsing)
# MARKETPLACE_TARGET_DOMAIN=play.marketplace-simulation.com

# Optional: Cloud Run backend
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# NAVIGATOR_GCS_BUCKET=your-artifact-bucket
# NAVIGATOR_CLOUD_BACKEND_URL=https://your-cloud-run-service-url
# NAVIGATOR_USE_CLOUD_BACKEND=0
